# Public hostname. Create an A record pointing this hostname to the VM static IP.
APP_DOMAIN="app.example.com"
APP_ORIGIN="https://app.example.com"
PASSWORD_RESET_ORIGIN="https://app.example.com"
PLATFORM_DOMAIN="app.example.com"
API_PORT=4201

# Generate unique random values before deployment. Keep database passwords URL-safe.
POSTGRES_PASSWORD="CHANGE_ME_DATABASE_PASSWORD"
DATABASE_URL="postgresql://appointit:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/appointit?schema=public"
REDIS_PASSWORD="CHANGE_ME_REDIS_PASSWORD"
REDIS_URL="redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379"
JWT_ACCESS_SECRET="CHANGE_ME_64_CHARACTER_ACCESS_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_64_CHARACTER_REFRESH_SECRET"
TOKEN_ENCRYPTION_KEY="CHANGE_ME_32_CHARACTER_ENCRYPTION_KEY"

# Platform email. Prefer a transactional provider in production.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AppointIt <no-reply@example.com>"

# Platform phone verification.
SMS_PROVIDER="afromessage"
AFROMESSAGE_API_URL="https://api.afromessage.com/api"
AFROMESSAGE_API_TOKEN=""
AFROMESSAGE_IDENTIFIER_ID=""
AFROMESSAGE_SENDER_NAME=""
AFROMESSAGE_CALLBACK_URL="https://app.example.com/api/webhooks/afromessage/status"
AFROMESSAGE_CALLBACK_SECRET="CHANGE_ME_CALLBACK_SECRET"
AFROMESSAGE_OTP_TTL_SECONDS=300
TELEBIRR_PAYMENT_PHONE=+251900000000
TELEBIRR_SMS_GATEWAY_SECRET=replace-with-a-long-random-secret
PAYMENT_INVOICE_TTL_HOURS=168

# Optional integrations.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://app.example.com/api/calendar/google/callback"
TELEGRAM_CLIENT_ID=""
TELEGRAM_CLIENT_SECRET=""
TELEGRAM_REDIRECT_URI="https://app.example.com/api/telegram/login/callback"
CUSTOM_DOMAIN_PROVIDER="manual"
CUSTOM_DOMAIN_CNAME_TARGET="app.example.com"
CUSTOM_DOMAIN_A_TARGET="203.0.113.10"
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
